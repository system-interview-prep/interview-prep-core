# Standalone Voice Lab only
# Copy these values into your normal local environment; never commit real secrets.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VOICE_LAB_STT_MODEL=gpt-4o-mini-transcribe
VOICE_LAB_STT_LANGUAGE=vi
VOICE_LAB_VAD_MIN_SPEECH_DURATION=0.15
VOICE_LAB_VAD_MIN_SILENCE_DURATION=1.30
VOICE_LAB_VAD_ACTIVATION_THRESHOLD=0.62
VOICE_LAB_VAD_DEACTIVATION_THRESHOLD=0.45
VOICE_LAB_LLM_MODEL=gpt-5.6-mini
VOICE_LAB_REALTIME_MODEL=gpt-realtime
VOICE_LAB_REALTIME_VOICE=marin

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# LiveKit — reserved for the next WebRTC comparison step.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=intervia-voice
LIVEKIT_STT_MODEL=assemblyai/universal-3-5-pro
LIVEKIT_STT_LANGUAGE=auto
