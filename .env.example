# App config
APP_ENV=
APP_HOST=
APP_PORT=
CORS_ORIGINS=

# Security
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=
JWT_EXPIRES_MINUTES=10080

# Google OAuth
GOOGLE_OAUTH_USERINFO_URL=
# Database
DATABASE_URL=

# Message broker
RABBITMQ_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
RABBITMQ_CV_QUEUE=
RABBITMQ_JD_QUEUE=
RABBITMQ_MATCHING_QUEUE=
RABBITMQ_RETRY_DELAY_MS=
RABBITMQ_MAX_ATTEMPTS=
RABBITMQ_PREFETCH=

# Cloudflare R2 Object Storage
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=

# OpenAI / LLM
OPENAI_API_KEY=
LLM_PROVIDER=
LLM_MODEL=gpt-5.4-mini-2026-03-17
JD_PARSER_MAX_OUTPUT_TOKENS=768
CV_PARSER_MAX_OUTPUT_TOKENS=1024
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_DIR=models_cache/embedding_cache

# Self-hosted AI model service (Colab / RunPod / Vast / GCP)
# Keep parser modes deterministic until the configured model endpoint is reachable.
JD_PARSER_MODE=deterministic
CV_PARSER_MODE=deterministic
AI_MODEL_URL=
AI_SERVICE_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1024

# MinerU
MINERU_API_KEY=
MINERU_BASE_URL=
MINERU_MODEL_VERSION=
MINERU_LANGUAGE=
MINERU_HTTP_CONNECT_TIMEOUT_SECONDS=20
MINERU_HTTP_READ_TIMEOUT_SECONDS=120
MINERU_HTTP_WRITE_TIMEOUT_SECONDS=120
MINERU_HTTP_POOL_TIMEOUT_SECONDS=20
MINERU_POLL_INTERVAL_SECONDS=
MINERU_TIMEOUT_SECONDS=
SSE_STATUS_POLL_INTERVAL_SECONDS=1.0
SSE_HEARTBEAT_SECONDS=15.0

# App runtime
WORKER_SECRET=
API_BASE_URL=
RESUME_MATCHING_SERVICE_URL=
