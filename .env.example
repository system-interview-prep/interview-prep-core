APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
# Frontend gets a Google access token, then sends it to POST /auth/google.
GOOGLE_OAUTH_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo

# Cloudflare R2 S3-compatible API. Use an Object Read & Write R2 API token.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=interview-prep
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional custom domain for objects exposed publicly; downloads remain authenticated by this API.
R2_PUBLIC_DOMAIN=

RABBITMQ_URL=amqp://interview:interview_password@rabbitmq:5672/
CELERY_BROKER_URL=amqp://interview:interview_password@rabbitmq:5672/
CELERY_RESULT_BACKEND=rpc://
RABBITMQ_CV_QUEUE=cv-processing
RABBITMQ_JP_QUEUE=jp-processing
RABBITMQ_MATCHING_QUEUE=matching
RABBITMQ_RETRY_DELAY_MS=10000
RABBITMQ_MAX_ATTEMPTS=3

DATABASE_URL=postgresql://user:password@postgres-db:5432/matching_db
VECTOR_DIMENSION=1024
EMBEDDING_DIMENSION=1024
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6
RRF_K=60
USE_GPU=false
MODEL_CACHE_DIR=/models

# MinerU Precision Extract API (https://mineru.net). CV parsing is performed
# in MinerU Cloud; do not commit a real key.
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_TIMEOUT_SECONDS=300
# OpenAI is the only LLM and embedding provider. Keep the API key out of Git.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3 supports custom dimensions; must equal VECTOR_DIMENSION.
EMBEDDING_DIMENSION=1024
