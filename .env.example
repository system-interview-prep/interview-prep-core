# Leave a key out to use the default in src/core/config.py; an empty value is not a default.
# App config
APP_ENV=
APP_HOST=
APP_PORT=5000
CORS_ORIGINS=
# TRACE_LOGS_ENABLED=true   (unset = on in development/test)
TRACE_LOGS_DIR=trace-logs
# Seed the curated Question Bank. Empty = only in development/test APP_ENV.
# Must be true for any demo deployment, or every interview fails closed (409).
# QUESTION_BANK_SEED_ENABLED=true   (unset = seed only when APP_ENV is development/test)
# A JD skill with no approved question (nor broader-skill / role fallback) gets an
# LLM-generated question, used in that interview and filed IN_REVIEW. false = drop
# the skill and report it uncovered.
QUESTION_GENERATION_ENABLED=true
# Pre-generate gated questions for must-have skills when a job is published
QUESTION_PREGENERATION_ENABLED=true

# Security
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=
JWT_EXPIRES_MINUTES=10080

# Initial administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Google OAuth
GOOGLE_OAUTH_USERINFO_URL=
# Optional Google Cloud Translation Basic key. Enables the on-demand
# "Translate to Vietnamese" button on English job descriptions.
# Database
DATABASE_URL=

# Message broker
RABBITMQ_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
RABBITMQ_CV_QUEUE=
RABBITMQ_JD_QUEUE=
RABBITMQ_MATCHING_QUEUE=
RABBITMQ_RETRY_DELAY_MS=
RABBITMQ_MAX_ATTEMPTS=3
RABBITMQ_PREFETCH=

# Cloudflare R2 Object Storage
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=

# OpenAI / LLM
OPENAI_API_KEY=
# ElevenLabs TTS for the LiveKit interview agent.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Prefer a voice whose native accent matches each interview locale.
ELEVENLABS_VI_VOICE_ID=
ELEVENLABS_EN_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Spoken when ElevenLabs fails (e.g. quota exhausted), through LiveKit Inference
# with the LiveKit credentials. Leave the model empty to disable the fallback.
VOICE_LAB_FALLBACK_TTS_MODEL=cartesia/sonic-3
VOICE_LAB_FALLBACK_TTS_VOICE=
VOICE_LAB_TTS_RETRIES_BEFORE_FALLBACK=1
# Enable authenticated voice endpoints and the LiveKit interview adapter.
VOICE_LAB_ENABLED=false
VOICE_LAB_REALTIME_MODEL=gpt-realtime-2.1
VOICE_LAB_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_LAB_TTS_MODEL=gpt-4o-mini-tts
VOICE_LAB_VOICE=marin
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=intervia-voice
LIVEKIT_AGENT_AUTOSTART=false
LIVEKIT_AGENT_IDLE_PROCESSES=1
LIVEKIT_AGENT_MAX_RETRY=32
LIVEKIT_AGENT_RUN_MODE=dev
# Optional DNS upstreams used only by the Docker voice-agent service. Override
# these when production requires an internal/corporate resolver.
VOICE_AGENT_DNS_PRIMARY=1.1.1.1
VOICE_AGENT_DNS_SECONDARY=8.8.8.8
# Override when the LiveKit worker runs outside the API container, e.g. http://backend:5000.
VOICE_RUNTIME_API_BASE_URL=http://127.0.0.1:5000
LIVEKIT_STT_MODEL=assemblyai/universal-3-6-pro
# Interviews are Vietnamese-only; docker-compose pins this to vi.
LIVEKIT_STT_LANGUAGE=vi
VOICE_LAB_STT_MIN_TURN_SILENCE_MS=600
VOICE_LAB_STT_MAX_TURN_SILENCE_MS=2000
VOICE_LAB_STT_VAD_THRESHOLD=0.30
VOICE_LAB_STT_MIN_CONFIDENCE=0.45
VOICE_LAB_NOISE_CANCELLATION=bvc
VOICE_LAB_VAD_MIN_SPEECH_DURATION=0.20
VOICE_LAB_VAD_MIN_SILENCE_DURATION=0.45
VOICE_LAB_VAD_ACTIVATION_THRESHOLD=0.50
VOICE_LAB_VAD_DEACTIVATION_THRESHOLD=0.35
VOICE_LAB_ENDPOINT_MAX_DELAY=1.8
VOICE_LAB_INTERRUPTION_MODE=adaptive
VOICE_LAB_INTERRUPTION_MIN_DURATION=0.5
VOICE_LAB_INTERRUPTION_MIN_WORDS=1
VOICE_LAB_FALSE_INTERRUPTION_TIMEOUT=1.0
VOICE_LAB_BACKCHANNEL_START_BOUNDARY=0.5
VOICE_LAB_BACKCHANNEL_END_BOUNDARY=2.2
VOICE_LAB_AEC_WARMUP_DURATION=2.0
VOICE_LAB_MIN_CONSECUTIVE_SPEECH_DELAY=0.18
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_SPEED=0.98
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_AUTO_MODE=true
ELEVENLABS_TEXT_NORMALIZATION=auto
# auto omits language_code so Vietnamese sentences can pronounce embedded
# English technical terms naturally. Use locale to force vi/en for monolingual use.
ELEVENLABS_LANGUAGE_MODE=auto
LLM_PROVIDER=
LLM_MODEL=gpt-5.4-mini-2026-03-17
# Opt-in dynamic planner. The JSON is mandatory when enabled; values are
# Product policy and therefore intentionally have no application defaults.
INTERVIEW_DYNAMIC_PLANNER_ENABLED=false
INTERVIEW_PLANNER_POLICY_JSON=
JD_PARSER_MAX_OUTPUT_TOKENS=4096
CV_PARSER_MAX_OUTPUT_TOKENS=4096
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_DIR=models_cache/embedding_cache

# TypeSafe / Jev clarification analysis
# Disabled by default. When enabled, Jev only analyzes requirements that the
# existing matching pipeline has already marked as unknown. It does not change
# requirement status, eligibility, suitabilityScore, or fitBand.
JEV_CLARIFICATION_ENABLED=false
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_CLARIFICATION_CONFIDENCE_THRESHOLD=0.75
JEV_MAX_EVIDENCE_ITEMS=5

# AI-authored matching clarification questions. Keep disabled until a
# requirement-specific validation set has been used to calibrate the semantic
# alignment threshold. This does not affect /match scoring.
MATCHING_CLARIFICATION_QUESTIONS_ENABLED=false
MATCHING_CLARIFICATION_MODEL=gpt-5.4-mini
# Set only after calibration on reviewed Vietnamese clarification examples.
MATCHING_CLARIFICATION_SEMANTIC_THRESHOLD=

# Matching may ask the LLM to find missing evidence in complete raw CV text.
# The LLM can return only verbatim excerpts; backend verifies each excerpt exists
# before it becomes evidence. No API key means deterministic matching only.
MATCHING_LLM_EVIDENCE_SEARCH_ENABLED=true
MATCHING_LLM_EVIDENCE_SEARCH_MAX_CHARS=12000
MATCHING_LLM_EVIDENCE_SEARCH_MAX_REQUIREMENTS=12

# Self-hosted AI model service (Colab / RunPod / Vast / GCP)
# Keep parser modes deterministic until the configured model endpoint is reachable.
# hybrid = deterministic baseline + grounded LLM claims (needs OPENAI_API_KEY).
JD_PARSER_MODE=deterministic
CV_PARSER_MODE=deterministic
PARSER_SECTION_REGEX_V2_ENABLED=true
AI_MODEL_URL=
AI_SERVICE_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1024

# OCR provider adapter. Use "mineru" to keep the existing provider or
# "paddleocr" to use PaddleOCR Online through the AI Studio hosted API.
OCR_PROVIDER=mineru
# Tried when OCR_PROVIDER fails (outage, timeout, API error, missing key, empty output).
# auto = the other provider (mineru <-> paddleocr), none = no fallback.
OCR_FALLBACK_PROVIDER=auto
# Read born-digital PDFs and .docx locally (no upload); scans/images still go to OCR.
PDF_TEXT_LAYER_ENABLED=true

# MinerU
MINERU_API_KEY=
MINERU_BASE_URL=
MINERU_MODEL_VERSION=
MINERU_LANGUAGE=
MINERU_HTTP_CONNECT_TIMEOUT_SECONDS=20
MINERU_HTTP_READ_TIMEOUT_SECONDS=120
MINERU_HTTP_WRITE_TIMEOUT_SECONDS=120
MINERU_HTTP_POOL_TIMEOUT_SECONDS=20
MINERU_POLL_INTERVAL_SECONDS=2.0
MINERU_TIMEOUT_SECONDS=300

# PaddleOCR Online / AI Studio
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_REQUEST_TIMEOUT_SECONDS=120
PADDLEOCR_POLL_INTERVAL_SECONDS=2
PADDLEOCR_TIMEOUT_SECONDS=600
SSE_STATUS_POLL_INTERVAL_SECONDS=1.0
SSE_HEARTBEAT_SECONDS=15.0

# App runtime
WORKER_SECRET=
API_BASE_URL=
RESUME_MATCHING_SERVICE_URL=
# Keep unstructured /ai/chat, /ai/chat-voice and /interview/video-calls disabled.
LEGACY_INTERVIEW_API_ENABLED=false
INTERVIEW_AI_REQUESTS_PER_MINUTE=20
